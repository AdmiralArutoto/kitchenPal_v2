generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; "rhel-openssl-3.0.x" for the Vercel Node 20 runtime (Amazon Linux 2023).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id            String       @id @db.Uuid
  name          String?
  preferences   String[]
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt       @map("updated_at")
  recipes       Recipe[]
  dailyBatches  DailyBatch[]

  @@map("profiles")
}

model Recipe {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid @map("user_id")
  name        String
  description String?
  ingredients Json
  steps       Json
  tags        String[]
  cookingTime Int?     @map("cooking_time")
  servings    Int?
  emoji       String?
  imageUrl    String?  @map("image_url")
  source      String
  sourceUrl       String?  @map("source_url")
  sourcePlatform  String?  @map("source_platform")
  sourceCreator   String?  @map("source_creator")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt       @map("updated_at")
  profile     Profile  @relation(fields: [userId], references: [id])

  @@map("recipes")
}

model DailyBatch {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  batchDate String   @map("batch_date")
  recipes   Json
  createdAt DateTime @default(now()) @map("created_at")
  profile   Profile  @relation(fields: [userId], references: [id])

  @@unique([userId, batchDate])
  @@map("daily_batches")
}
